execute as @e[type=wind_charge] at @s if entity @e[type=item_frame,nbt={Item:{id: "minecraft:turtle_helmet"}},distance=0..2] if block ~ ~-1 ~ dark_prismarine if block ~1 ~ ~ blue_candle[lit=true] if block ~-1 ~ ~ blue_candle[lit=true] if block ~ ~ ~1 blue_candle[lit=true] if block ~ ~ ~-1 blue_candle[lit=true] if entity @e[type=item,nbt={Item:{id:"minecraft:blaze_powder"}},distance=0..1] if entity @e[type=item,nbt={id:"minecraft:totem_of_undying",tag:{Enchantments:[{id:"minecraft:flame",lvl:1s}]}},distance=0..1] if entity @e[type=item,nbt={id:"minecraft:prismarine_shard"},distance=0..1] if entity @e[type=item,nbt={id:"minecraft:amethyst_shard"},distance=0..1] run tag @s add guardian_spell

