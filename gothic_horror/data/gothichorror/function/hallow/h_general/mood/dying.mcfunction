# Define
scoreboard objectives add hGeneralDyingChance dummy

# Main

execute as @s at @s unless predicate gstools:sky positioned ~ ~15 ~ unless predicate gstools:sky positioned ~ ~-15 ~ if entity @a[distance=0..100] run scoreboard players operation @s hGeneralDyingChance = @s horrorIndex
