execute if entity @e[type=marker,tag=gstools_worker,scores={averageTps=16..}] run scoreboard players set @e[tag=gstools_worker,type=marker,limit=1] hasSummonedPreCursor 0

execute if entity @e[type=marker,tag=gstools_worker,scores={averageTps=16..}] as @e[tag=gstools_worker,type=marker] run scoreboard players set @s maxNumberOfUnloadedCursorsPerChunk 800

